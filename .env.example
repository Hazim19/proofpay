# ProofPay environment configuration (copy to .env or export in your shell)

# Port the HTTP server listens on
PORT=3000

# PayPal mode: "mock" forces deterministic offline mock responses.
# If PAYPAL_MODE is unset and the credentials below are missing, mock mode is used automatically.
PAYPAL_MODE=mock

# PayPal environment: sandbox | live
PAYPAL_ENV=sandbox

# PayPal REST app credentials (from https://developer.paypal.com/dashboard/applications)
# NEVER commit real values. Leave empty to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: webhook id for signature verification of incoming webhooks (live mode)
PAYPAL_WEBHOOK_ID=

# Runtime settings (the /connect page)
# Credentials saved through http://localhost:3000/connect are stored in this
# file instead of the environment. Environment variables always take
# precedence over the file. The file is created mode 0600 and is gitignored.
PROOFPAY_SECRETS_FILE=./data/secrets.json
# Guards /connect and /api/settings when set (header "x-setup-token" or
# "?setup_token="). When unset the settings page is open and the server logs
# a warning at startup — set this before exposing the app beyond localhost.
PROOFPAY_SETUP_TOKEN=

# JSON data store location (relative to project root or absolute)
DATA_FILE=./data/db.json

# AI layer (contract drafter + deliverable verifier)
# Any OpenAI-compatible chat endpoint. ALL THREE must be set for live mode;
# if any is missing, the deterministic stubs in src/ai/stubs.ts are used and
# the app runs fully offline. The prompts live in src/ai/prompts.ts.
# NEVER commit a real key.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
